classDiagram
    direction LR

    class Priority {
        <<enumeration>>
        LOW = 1
        MEDIUM = 2
        HIGH = 3
    }

    class Frequency {
        <<enumeration>>
        ONCE
        DAILY
        WEEKLY
        +interval() timedelta
    }

    class Owner {
        +str name
        +int available_minutes
        +list~Pet~ pets
        +add_pet(pet: Pet) None
        +remove_pet(pet_name: str) bool
        +get_pet(pet_name: str) Pet
        +get_all_tasks() list~Task~
    }

    class Pet {
        +str name
        +str species
        +str breed
        +int age
        +list~Task~ tasks
        +add_task(task: Task) None
        +remove_task(task: Task) bool
        +get_tasks(include_completed: bool) list~Task~
    }

    class Task {
        +str description
        +time time
        +int duration_minutes
        +Priority priority
        +Frequency frequency
        +date due_date
        +bool completed
        +str pet_name
        +start() datetime
        +end() datetime
        +is_due_on(day: date) bool
        +overlaps(other: Task) bool
        +mark_complete() Task
    }

    class Scheduler {
        +Owner owner
        +list~Task~ plan
        +list~tuple~ skipped
        +get_tasks_for_day(day: date) list~Task~
        +filter_by_pet(pet_name: str) list~Task~
        +filter_by_status(completed: bool) list~Task~
        +sort_by_time(tasks) list~Task~
        +sort_by_priority(tasks) list~Task~
        +detect_conflicts(day: date) list~str~
        +generate_plan(day: date) list~Task~
        +total_minutes() int
        +complete_task(task: Task) Task
        +explain() str
    }

    Owner "1" o-- "0..*" Pet : owns
    Pet "1" *-- "0..*" Task : needs
    Task --> Priority : has
    Task --> Frequency : repeats
    Scheduler "1" --> "1" Owner : manages
    Scheduler ..> Task : organizes
